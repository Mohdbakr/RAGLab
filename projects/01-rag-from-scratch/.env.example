# Copy this file to .env and fill in your values.
# litellm loads .env automatically on import — no extra wiring needed.

# Required for the default models (text-embedding-3-small, gpt-4o-mini).
OPENAI_API_KEY=

# Using a different litellm-supported provider instead? Set its key here
# and pass a matching model string via --embedding-model / --chat-model,
# e.g.:
# ANTHROPIC_API_KEY=
# COHERE_API_KEY=
