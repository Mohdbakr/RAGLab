# Model used when a request doesn't specify one. "local/..." needs no API
# key; anything else (e.g. "openai/text-embedding-3-small") needs that
# provider's API key set as an env var (OPENAI_API_KEY, etc.) — see litellm's
# docs for the exact variable name per provider.
DEFAULT_EMBEDDING_MODEL=local/all-mpnet-base-v2
